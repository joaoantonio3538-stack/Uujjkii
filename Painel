local function GetPlayerNames()
	local list = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			table.insert(list, plr.Name)
		end
	end
	return list
end

local function GetPlayerByQuery(q)
	if not q or q == "" then return nil end
	local lower = q:lower()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			if plr.Name:lower():find(lower, 1, true) or plr.DisplayName:lower():find(lower, 1, true) then
				return plr
			end
		end
	end
	return nil
end

local function FlingTarget(target)
	if not target or not target.Character then return end
	local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
	local tHum = target.Character:FindFirstChildOfClass("Humanoid")
	local myHRP = GetHRP()
	local myHum = GetHum()
	if not tHRP or not myHRP or not myHum then return end
	if tHum and tHum.Sit then return end

	pcall(function()
		myHum:ChangeState(Enum.HumanoidStateType.Physics)
		myHRP.CFrame = tHRP.CFrame * CFrame.new(0, 0, -1)
		myHRP.AssemblyLinearVelocity = Vector3.new(85000, 85000, 85000)
		myHRP.AssemblyAngularVelocity = Vector3.new(850000, 850000, 850000)
	end)
end

local function PlayLocalOrRemoteSound(id)
	local clean = tostring(id or ""):gsub("%D", "")
	if clean == "" then return end
	local asset = "rbxassetid://" .. clean

	FireRE("1Gu1i", "newSound", "GlobalSound", Workspace, asset, 1, 10, false)

	local hrp = GetHRP()
	if hrp then
		local prev = hrp:FindFirstChild("SlayerSound")
		if prev then prev:Destroy() end

		local snd = Instance.new("Sound")
		snd.Name = "SlayerSound"
		snd.SoundId = asset
		snd.Volume = 2
		snd.Parent = hrp
		pcall(function() snd:Play() end)
	end
end

local function StopSounds()
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Sound") and obj.Name == "SlayerSound" then
			pcall(function() obj:Stop() end)
			obj:Destroy()
		end
	end
end

