-- Funções auxiliares seguras
local function GetChar()
	return LocalPlayer.Character
end

local function GetHRP()
	local c = GetChar()
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function GetHum()
	local c = GetChar()
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function FindRemote(name)
	local re = ReplicatedStorage:FindFirstChild("RE")
	if re and re:FindFirstChild(name) then
		return re:FindFirstChild(name)
	end
	for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
		if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) and obj.Name == name then
			return obj
		end
	end
	return nil
end

local function FireRE(remoteName, ...)
	local r = FindRemote(remoteName)
	if r and r:IsA("RemoteEvent") then
		pcall(function(...)
			r:FireServer(...)
		end, ...)
	end
end

local function InvokeRF(remoteName, ...)
	local r = FindRemote(remoteName)
	if r and r:IsA("RemoteFunction") then
		pcall(function(...)
			r:InvokeServer(...)
		end, ...)
	end
end

local function GiveTool(toolName)
	FireRE("1Clea1rTool1s", "ClearAllTools")
	task.wait(0.1)
	InvokeRF("1Too1l", "PickingTools", toolName)
end

