-- ==========================================
-- LOOP ÚNICO DE EXECUÇÃO (LEVE E ESTÁVEL)
-- ==========================================
local hue = 0
local orbitAngle = 0
local timer = 0

RunService.Heartbeat:Connect(function(dt)
	timer += dt
	hue = (hue + dt * (State.RGBSpeed * 0.08)) % 1
	local col = Color3.fromHSV(hue, 1, 1)

	local hrp = GetHRP()
	local hum = GetHum()
	local char = GetChar()

	-- Proteções
	if State.AntiSit and hum then
		hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
		if hum.Sit then hum.Sit = false end
	end

	if State.AntiVoid and hrp and hrp.Position.Y < -85 then
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.CFrame = CFrame.new(0, 20, 0)
	end

	if State.AntiCollision then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character then
				for _, p in ipairs(plr.Character:GetDescendants()) do
					if p:IsA("BasePart") then p.CanCollide = false end
				end
			end
		end
	end

	-- Spectate
	if State.SpectateActive and State.SelectedPlayer and State.SelectedPlayer.Character then
		local tHum = State.SelectedPlayer.Character:FindFirstChildOfClass("Humanoid")
		if tHum then Workspace.CurrentCamera.CameraSubject = tHum end
	end

	-- Fling / Kill / Orbit
	if (State.KillActive or State.FlingActive) and State.SelectedPlayer then
		FlingTarget(State.SelectedPlayer)
	elseif State.OrbitActive and hrp and State.SelectedPlayer and State.SelectedPlayer.Character then
		local tHRP = State.SelectedPlayer.Character:FindFirstChild("HumanoidRootPart")
		if tHRP then
			orbitAngle += dt * 5
			hrp.CFrame = tHRP.CFrame * CFrame.new(math.cos(orbitAngle) * 7, 1.5, math.sin(orbitAngle) * 7)
		end
	end

	if State.FlingAllActive then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer then
				FlingTarget(plr)
			end
		end
	end

	-- Fly Car
	if State.FlyCarActive then
		local seat = GetSeat()
		if seat then
			seat.AssemblyLinearVelocity = Workspace.CurrentCamera.CFrame.LookVector * State.CarSpeed
		end
	end

	-- Ações periódicas (a cada ~0.35s)
	if timer >= 0.35 then
		timer = 0

		if State.DoorsAuraActive and hrp then
			for _, cd in ipairs(Workspace:GetDescendants()) do
				if cd:IsA("ClickDetector") and cd.Parent and cd.Parent:IsA("BasePart") then
					if (cd.Parent.Position - hrp.Position).Magnitude <= 22 then
						pcall(fireclickdetector, cd)
					end
				end
			end
		end

		if State.PullCarsActive and hrp then
			local vFolder = Workspace:FindFirstChild("Vehicles")
			if vFolder then
				for _, car in ipairs(vFolder:GetChildren()) do
					pcall(function()
						car:PivotTo(hrp.CFrame * CFrame.new(math.random(-10, 10), 2, -8))
					end)
				end
			end
		end

		if State.PlateLoopActive then
			FireRE("1Player1sCa1r", "PickingCarPlateText", State.PlateText)
		end

		if State.LoopAudioActive then
			PlayLocalOrRemoteSound(State.AudioId)
		end

		if State.RGBNameBio o
